{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fund-nav-index-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "triggers": {
    "crons": [
      "27 3 * * 1-5",
      "45 6 * * 1-5",
      "10 7 * * 1-5",
      "30 13 * * 1-5"
    ]
  },
  "observability": {
    "enabled": true
  }
}
